# Build configuration. Values can be overridden in config.local.env (not tracked).

# Image identity
DISTRO_NAME="Nirintu"
DISTRO_VERSION="24.04"
ISO_LABEL="NIRINTU_2404"
ISO_BASENAME="nirintu-24.04-amd64"

# Archive
SUITE="noble"
MIRROR="http://archive.ubuntu.com/ubuntu"
SECURITY_MIRROR="http://security.ubuntu.com/ubuntu"
KERNEL_FLAVOUR="generic-hwe-24.04"

# NVIDIA driver branch from the Ubuntu archive, with Canonical-signed prebuilt modules
# (linux-modules-nvidia-<branch>-<flavour>). Empty: Mesa only.
NVIDIA_DRIVER="580"

# Components built from source into .deb packages
NIRI_REPO="https://github.com/niri-wm/niri.git"
NIRI_REF="v26.04"
XWS_REPO="https://github.com/Supreeeme/xwayland-satellite.git"
XWS_REF="v0.8.3"
NOCTALIA_REPO="https://github.com/kabronius/noctalia.git"
NOCTALIA_REF="ubuntu-24.04"
GREETER_REPO="https://github.com/kabronius/noctalia-greeter.git"
GREETER_REF="feat/output-modes"
RUST_TOOLCHAIN="stable"

# Noctalia plugin sources preconfigured for new users (/etc/skel)
GREETER_PLUGIN_REPO="https://github.com/kabronius/noctalia-greeter-plugin"
VARIETY_PLUGIN_REPO="https://github.com/kabronius/noctalia-variety-plugin"

# GRUB themes (distro-grub-themes, GPL-3.0) shipped in the image; the installer picks one from the
# machine's DMI vendor/model (nirintu-grub-theme). Empty GRUB_THEMES: plain text menu.
GRUB_THEMES_REPO="https://raw.githubusercontent.com/AdisonCavani/distro-grub-themes"
GRUB_THEMES_COMMIT="6e9e018abf38c0b3ed2bff1912ecf30a94e0c917"
GRUB_THEMES="acer aorus apple asrock asus asus-rog asus-tuf dell framework framework13 fujitsu gigabyte hp hp-omen hp-victus huawei legion lenovo lg medion msi razer samsung supermicro system76 thinkpad toshiba vaio ubuntu"
GRUB_THEME_FALLBACK="ubuntu"

# Default icon theme (GTK and Noctalia)
ICON_THEME="Papirus-Dark"

# Live session; the installer sets locale, keyboard and timezone of the installed system
LIVE_USER="ubuntu"
LIVE_HOSTNAME="nirintu"
LIVE_LOCALE="it_IT.UTF-8"
LIVE_KEYMAP="it"
LIVE_TIMEZONE="Europe/Rome"

# Packages added to packages.list
EXTRA_PACKAGES=""

# squashfs compression (mksquashfs arguments)
SQUASHFS_COMP="-comp zstd -Xcompression-level 19 -b 1M"

# Host directory for sources, chroot, cache and output (needs ~25 GB)
WORKDIR="/var/tmp/nirintu"
